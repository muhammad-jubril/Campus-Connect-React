# Supabase public frontend variables go here.
# Never put service-role/secret keys in the frontend.
# Vite only exposes env vars prefixed with VITE_ to client code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site origin used when generating password-reset email links.
# Example: https://campus-connect-224y.vercel.app
VITE_SITE_URL=

# Browser-only Web Push configuration. The public VAPID key is not secret.
VITE_WEB_PUSH_PUBLIC_KEY=
# Deployed authenticated Supabase Edge Function URL (not a private push sender URL).
VITE_PUSH_SUBSCRIPTION_ENDPOINT=
